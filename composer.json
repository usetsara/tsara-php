{
  "name": "tsara/tsara-php",
  "description": "Official server-side PHP SDK for Tsara.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Tsara\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tsara\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "check": [
      "@composer validate --strict --no-check-lock",
      "@test"
    ]
  },
  "homepage": "https://github.com/usetsara/tsara-php",
  "keywords": [
    "tsara",
    "payments",
    "checkout",
    "sdk"
  ],
  "support": {
    "issues": "https://github.com/usetsara/tsara-php/issues",
    "source": "https://github.com/usetsara/tsara-php"
  },
  "archive": {
    "exclude": [
      "/tests",
      "/examples",
      "/.github",
      "/phpunit.xml",
      "/.phpunit.result.cache",
      "/composer.lock",
      "/PUBLISHING.md",
      "/RELEASE-READINESS.md",
      "/vendor",
      "/.env",
      "/.env.*",
      "/.phpunit.cache"
    ]
  }
}
